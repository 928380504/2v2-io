  "compilerOptions": {
    "allowJs": false,
    "incremental": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": []
  },
  "include": [
    "./**/*.ts",
    "./types.d.ts"
  ]
}
