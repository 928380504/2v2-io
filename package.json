{
  "name": "stimulation-clicker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "npm run docs:check && npm run backend:check && npm run competition:examples:check && npm run filters:check && npm run validate-site",
    "dev": "next dev",
    "build": "npm run docs:check && npm run backend:check && npm run competition:examples:check && npm run competition:install:test && npm run filters:check && npm run game:add:test && npm run site:create:test && npm run site:export:test && npm run site:admin:test && npm run cloudflare:test && npm run template:fleet:test && npm run site:adopt-legacy:test && npm run site:extract-legacy:test && npm run functions:migrate:test && npm run validate-site && npm run fetch-config && npm run fetch-ratings && next build",
    "postbuild": "npm run structured-data:check && next-sitemap && node scripts/clean-robots.js && npm run build:functions",
    "build:functions": "node scripts/build-pages-functions.mjs",
    "start": "next start",
    "lint": "eslint .",
    "fetch-config": "node scripts/fetch-site-config.mjs",
    "fetch-ratings": "node scripts/fetch-game-ratings.mjs",
    "docs:check": "node scripts/validate-template-docs.mjs",
    "backend:check": "node scripts/validate-backend.mjs",
    "competition:examples:check": "node scripts/validate-competition-examples.mjs",
    "competition:install": "node scripts/install-competition.mjs",
    "competition:install:test": "node --test scripts/competition-installer.test.mjs",
    "filters:check": "node scripts/validate-game-filters.mjs",
    "migrations:list": "node scripts/list-migrations.mjs",
    "validate-site": "node scripts/validate-site.mjs",
    "structured-data:check": "node scripts/validate-page-structured-data.mjs",
    "site:init": "node scripts/init-site.mjs",
    "site:create": "node scripts/create-site.mjs",
    "site:create:test": "node --test scripts/site-creator.test.mjs scripts/generated-cache-tools.test.mjs",
    "clean:generated": "node scripts/clean-generated-caches.mjs",
    "site:export": "node scripts/export-site-blueprint.mjs",
    "site:export:test": "node --test scripts/site-blueprint-export.test.mjs",
    "site:admin": "node scripts/site-admin.mjs",
    "site:admin:test": "node --test scripts/site-admin.test.mjs",
    "cloudflare:check": "node scripts/cloudflare-deploy.mjs check",
    "cloudflare:provision": "node scripts/cloudflare-deploy.mjs provision",
    "cloudflare:prepare": "node scripts/cloudflare-deploy.mjs prepare",
    "cloudflare:migrations": "node scripts/cloudflare-deploy.mjs migrations",
    "cloudflare:deploy": "node scripts/cloudflare-deploy.mjs deploy",
    "cloudflare:health": "node scripts/cloudflare-deploy.mjs health",
    "cloudflare:test": "node --test scripts/cloudflare-deployment.test.mjs",
    "game:add": "node scripts/add-game.mjs",
    "game:add:test": "node --test scripts/game-generator.test.mjs",
    "template:release": "node scripts/template-release.mjs",
    "template:verify": "node scripts/template-release.mjs --check",
    "template:sync": "node scripts/template-sync.mjs",
    "template:fleet": "node scripts/template-fleet.mjs",
    "template:fleet:test": "node --test scripts/template-fleet.test.mjs",
    "site:adopt-legacy": "node scripts/adopt-legacy-site.mjs",
    "site:adopt-legacy:test": "node --test scripts/legacy-adoption.test.mjs",
    "site:extract-legacy": "node scripts/extract-legacy-site.mjs",
    "site:extract-legacy:test": "node --test scripts/legacy-site-extractor.test.mjs",
    "functions:migrate": "node scripts/migrate-pages-functions.mjs",
    "functions:migrate:test": "node --test scripts/functions-migration.test.mjs"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.10",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.446.0",
    "makethisbetter": "^1.27.0",
    "next": "^16.3.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.4.0",
    "tailwind-merge": "^2.2.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "20.6.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "autoprefixer": "10.4.15",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "next-sitemap": "^4.2.3",
    "postcss": "^8.5.26",
    "tailwindcss": "3.3.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.119.0"
  }
}
